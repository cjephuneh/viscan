# -------------------------------------------------------------
# AI Avatar Service Configuration (FastAPI + Anam AI + Remote Postgres)
# -------------------------------------------------------------

# Application Server
APP_HOST=0.0.0.0
APP_PORT=9090
ENVIRONMENT=development
LOG_LEVEL=info

# Remote PostgreSQL Database
# Format: postgresql+asyncpg://<username>:<password>@<remote_host>:<remote_port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:your_password@remote-db-host.example.com:5432/viscan_avatar
DB_ECHO=false

# Anam AI Configuration (https://anam.ai)
ANAM_API_KEY=your_anam_api_key_here
ANAM_BASE_URL=https://api.anam.ai/v1

# Optional default Anam Persona / Avatar / Voice IDs
ANAM_DEFAULT_PERSONA_ID=
ANAM_DEFAULT_AVATAR_ID=
ANAM_DEFAULT_VOICE_ID=

# CORS Settings (comma-separated origins)
CORS_ORIGINS=*
