FLASK_APP=run.py
FLASK_CONFIG=development
PORT=8080

# Leave DATABASE_URL empty to build the URL from DB_* values.
# Password special characters are encoded automatically.
DATABASE_URL=

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=viscan
DB_SSLMODE=disable

# Public URL the AI service uses to fetch a VIA image.
PUBLIC_BASE_URL=http://localhost:8080
AI_API_URL=http://localhost:8000
AI_TIMEOUT_SECONDS=60

MAPS_API_KEY=
MAPS_API_URL=
SMS_API_KEY=
SMS_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
LANGUAGE_API_KEY=
LANGUAGE_API_URL=
VOICE_API_KEY=
VOICE_API_URL=

EXTERNAL_TIMEOUT_SECONDS=30
MAX_UPLOAD_BYTES=10485760
UPLOAD_FOLDER=uploads
CORS_ORIGINS=*
