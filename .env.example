# -------------------------------------------------------------------
# Deployment-level settings read by docker-compose.prod.yml.
# Copy to ./.env on the server. Per-service secrets (OpenAI, Anam, ...)
# live in <service>/.env  (see <service>/.env.example).
# -------------------------------------------------------------------

# PostgreSQL used by the core backend (runs on the Docker host on gp5).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=app_db
DB_SSLMODE=disable

# S3-compatible blob storage (MinIO) for VIA images.
# Shared by ai-interpreter (prefix interpreter/) and backend (prefix backend/).
S3_ENDPOINT=http://16.192.134.200:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=via-images
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Public domain served by the Nginx gateway over HTTPS (Let's Encrypt).
# DNS: A viscan.site -> server IP, A www.viscan.site -> server IP.
DOMAIN=viscan.site
# Let's Encrypt account e-mail (expiry warnings). Optional but recommended.
CERTBOT_EMAIL=
# Set to 1 to use Let's Encrypt's staging CA while testing (untrusted certs).
CERTBOT_STAGING=

# Optional: if set, ai-interpreter requires X-API-Key on every /api request
# and the frontend/backend send it automatically.
VISCAN_API_KEY=
