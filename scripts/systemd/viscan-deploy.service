[Unit]
Description=ViScan pull-based deployer (deploys origin/main once CI is green)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/home/ubuntu/viscan/scripts/server-deploy.sh
TimeoutStartSec=45min
