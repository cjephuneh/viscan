# auto = local vision weights when models/base is present, otherwise the colour baseline
# local | remote | hosted | heuristic
INTERPRETER_MODE=auto

# Repo downloaded by scripts/pull_model.py. This machine has no GPU and 8 GB of RAM,
# so the default is a 256M vision model. A Kaggle GPU run trains
# meta-llama/Llama-3.2-11B-Vision-Instruct and the adapter is loaded from
# LOCAL_ADAPTER_DIR when that folder exists.
LOCAL_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
# LOCAL_MODEL_DIR=
# LOCAL_ADAPTER_DIR=
LOCAL_MAX_NEW_TOKENS=700

# Hosted vision model. Sends each exam image to VISION_MODEL and stores the same VIA JSON.
# The key stays in this file. Do not commit .env.
# INTERPRETER_MODE=hosted
# VISION_API_KEY=
# VISION_MODEL=gpt-4o
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# VISION_API_TIMEOUT_SECONDS=90

# Any GPU runtime that is serving scripts/model_server.py.
# Colab: open notebooks/viscan_colab.ipynb and paste the URL it prints.
# INTERPRETER_MODE=remote
# REMOTE_MODEL_URL=https://the-gpu-host
# REMOTE_MODEL_TOKEN=
# REMOTE_MODEL_TIMEOUT_SECONDS=300

# Number of clinician-verified cases sent to the model as reference examples
FEWSHOT_EXAMPLES=2

# Extra model servers that read the same image together with the selected interpreter.
# Comma-separated URLs. The clinician still confirms one result.
# PANEL_URLS=
# PANEL_TIMEOUT_SECONDS=90

# AI results below this confidence are flagged as needing priority review
REVIEW_CONFIDENCE_THRESHOLD=0.75

# If set, every /api request must send the header  X-API-Key: <value>
VISCAN_API_KEY=

SECRET_KEY=change-me

# PostgreSQL (used when DB_HOST is set). Leave unset to use local SQLite.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=viscan
DB_SSLMODE=require
# Or a full URL instead, e.g. postgresql+psycopg://user:pass@host:5432/viscan
# DATABASE_URL=

# Mia, the pre-screening avatar (https://docs.anam.ai/)
ANAM_API_KEY=
ANAM_PERSONA_ID=34584421-e431-4c3e-b7c5-eece5793a7dc
# ANAM_LLM_ID=0934d97d-0c3a-4f33-91b0-5e136a0ef466

# S3-compatible blob storage (MinIO) for VIA images. Leave S3_ENDPOINT empty to
# keep images on local disk under UPLOAD_DIR. In production these are injected
# by docker-compose.prod.yml from the root .env.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=via-images
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PREFIX=interpreter/

# ai-avatar service (video report rendered after the clinician confirms a
# reading; the frontend embeds /player/viscan-<id>). Empty = disabled.
# Docker: http://ai-avatar:9090   Local: http://localhost:9090
AVATAR_API_URL=
AVATAR_TIMEOUT_SECONDS=60
