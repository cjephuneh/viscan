FLASK_APP=run.py
FLASK_CONFIG=development
PORT=8080

# Leave DATABASE_URL empty to build the URL from DB_* values.
# Password special characters are encoded automatically.
DATABASE_URL=

# Host process connects to the Docker Postgres published on localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=viscan_admin
DB_PASSWORD=viscan_password
DB_NAME=viscan
DB_SSLMODE=off

# AI interpreter service (POST {AI_API_URL}/api/v1/interpret). In Docker this is
# http://ai-interpreter:5050. AI_API_KEY must match the interpreter's VISCAN_API_KEY
# when that is set.
PUBLIC_BASE_URL=http://localhost:8080
AI_API_URL=http://localhost:5050
AI_API_KEY=
AI_TIMEOUT_SECONDS=120

# S3-compatible blob storage (MinIO) for VIA images. Leave S3_ENDPOINT empty to
# keep images on local disk under UPLOAD_FOLDER. In production these are
# injected by docker-compose.prod.yml from the root .env.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=via-images
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PREFIX=backend/

MAPS_API_KEY=
MAPS_API_URL=
SMS_API_KEY=
SMS_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
LANGUAGE_API_KEY=
LANGUAGE_API_URL=
VOICE_API_KEY=
VOICE_API_URL=

EXTERNAL_TIMEOUT_SECONDS=30

# VIA analysis queue. One image is analyzed at a time.
QUEUE_WORKER_ENABLED=true
QUEUE_POLL_SECONDS=0.5
QUEUE_STALE_SECONDS=120
QUEUE_MAX_ATTEMPTS=2

MAX_UPLOAD_BYTES=10485760
UPLOAD_FOLDER=uploads
CORS_ORIGINS=*
