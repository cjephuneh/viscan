FLASK_APP=run.py
FLASK_CONFIG=development
PORT=8080

# Leave DATABASE_URL empty to build the URL from DB_* values.
# Password special characters are encoded automatically.
DATABASE_URL=

# Host process connects to the Docker Postgres published on localhost.
DB_HOST=localhost
DB_PORT=5432
DB_USER=viscan_admin
DB_PASSWORD=viscan_password
DB_NAME=viscan
DB_SSLMODE=off

# Public URL the AI service uses to fetch a VIA image.
PUBLIC_BASE_URL=http://localhost:8080
AI_API_URL=http://localhost:8000
AI_TIMEOUT_SECONDS=60

MAPS_API_KEY=
MAPS_API_URL=
SMS_API_KEY=
SMS_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
LANGUAGE_API_KEY=
LANGUAGE_API_URL=
VOICE_API_KEY=
VOICE_API_URL=

EXTERNAL_TIMEOUT_SECONDS=30

# VIA analysis queue. Up to QUEUE_CONCURRENCY images run at the same time.
QUEUE_WORKER_ENABLED=true
QUEUE_CONCURRENCY=100
QUEUE_POLL_SECONDS=0.5
QUEUE_STALE_SECONDS=120
QUEUE_MAX_ATTEMPTS=2
# 1 to 3. Later phases receive the previous model's result.
AI_PHASE_COUNT=3
# Optional comma-separated URLs, one per phase. Empty uses AI_API_URL for every phase.
AI_PHASE_URLS=

MAX_UPLOAD_BYTES=10485760
UPLOAD_FOLDER=uploads
CORS_ORIGINS=*
